# Local Architype environment
# Copy to .env.local (Next.js) and supabase/functions/.env (Edge Functions).
# Never commit real keys. Hosted projects must use unique values, not these defaults.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# The ai-worker Edge Function reads its Supabase credentials from SUPABASE_SECRET_KEYS,
# which both the local and hosted edge runtimes inject. Do not add it here: the
# `SUPABASE_` prefix is reserved and `supabase secrets set` rejects it.

# Must match Vault secret `automations` (local seed sets local-dev-automation-secret).
AUTOMATION_SECRET=local-dev-automation-secret

# OpenRouter key for design and spec workers. Set as an Edge Function secret in hosted projects.
OPENROUTER_API_KEY=
